@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-center mb-4">Система оценки текстов</h2>
            <form method="post" class="card p-4 shadow-sm">

                <div class="mb-3">
                    <label for="country" class="form-label fw-bold">Страна гражданства:</label>
                    <select name="country" id="country" class="form-select">
                        <option value="Russia">Russia</option>
                        <option value="France">France</option>
                        <option value="Germany">Germany</option>
                        <option value="UAE">UAE</option>
                        <option value="India">India</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="text" class="form-label fw-bold">Текст для оценки:</label>
                    <textarea name="text" id="text" rows="5" class="form-control" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100">Оценить текст</button>
            </form>
        </div>
    </div>
</div>